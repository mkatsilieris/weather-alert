# Copy to .env and adjust. docker compose reads this file automatically.

# Port exposed on the host (browser + mobile use this). 8081 so that it can live next to Bill Split (8080).
WEB_PORT=8081

# Public URL of the app (password reset links, the only allowed CORS origin)
APP_URL=http://localhost:8081

# Internet access through Cloudflare Tunnel (see README). Remove both lines to run on the
# local network only. Token: Zero Trust > Networks > Tunnels > weather-alert > Configure.
#COMPOSE_PROFILES=internet
#TUNNEL_TOKEN=

# Secret used to sign login tokens. CHANGE THIS on the Raspberry Pi:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# API log detail: debug | info | warn | error. Logs:  docker compose logs -f api
LOG_LEVEL=info

# Time zone used in the notification texts ("arrives at 15:40")
DISPLAY_TZ=Europe/Athens

# Database (internal to docker, no need to change)
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather

# ---- The scan ----
# open-meteo (default, free, no key) or openweathermap (needs OWM_API_KEY)
WEATHER_PROVIDER=open-meteo
#OWM_API_KEY=
# Centre and radius of the area that is watched (default: 100 km around Athens)
SCAN_CENTER_LAT=37.9838
SCAN_CENTER_LON=23.7275
SCAN_RADIUS_KM=100
# Distance between sample points. 15 km -> ~140 points per scan; 10 km -> ~315.
SCAN_GRID_KM=15
# How often to scan, in minutes
SCAN_INTERVAL_MIN=60
# Precipitation (mm/h) from which a point counts as raining
RAIN_MIN_RATE=0.2
# At most one notification per person in this many minutes (except when it starts raining)
ALERT_COOLDOWN_MIN=30

# ---- Web Push ----
# Leave empty: a VAPID key pair is generated on first start and kept in the database.
# Set them only to carry the same pair to another installation (web-push generate-vapid-keys).
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

# ---- Optional SMTP for e-mail alerts and "forgot password" ----
# If left empty the reset link is printed in the api logs:  docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Weather Alert <no-reply@example.com>"
